st.sidebar.image(
    "https://cdn-icons-png.flaticon.com/512/857/857455.png",
    width=120
)

st.sidebar.markdown("# 🏏 IPL Predictor")

# =========================================================
# MODEL SELECTION
# =========================================================

algorithm = st.sidebar.selectbox(

    "🤖 Select ML Algorithm",

    [
        "XGBoost",
        "Random Forest",
        "Gradient Boosting",
        "Logistic Regression",
        "Decision Tree"
    ]
)

# =========================================================
# SELECT MODEL
# =========================================================

if algorithm == "XGBoost":

    model = xgb_model

elif algorithm == "Random Forest":

    model = rf_model

elif algorithm == "Gradient Boosting":

    model = gb_model

elif algorithm == "Logistic Regression":

    model = lr_model

else:

    model = dt_model

# =========================================================
# TEAMS
# =========================================================

teams = [

    'Mumbai Indians',
    'Chennai Super Kings',
    'Royal Challengers Bangalore',
    'Kolkata Knight Riders',
    'Delhi Capitals',
    'Punjab Kings',
    'Rajasthan Royals',
    'Sunrisers Hyderabad'

]

# =========================================================
# VENUES
# =========================================================

venues = [

    'Wankhede Stadium, Mumbai',
    'Eden Gardens, Kolkata',
    'M Chinnaswamy Stadium, Bangalore',
    'Arun Jaitley Stadium, Delhi',
    'MA Chidambaram Stadium, Chennai',
    'Narendra Modi Stadium, Ahmedabad',
    'Rajiv Gandhi Stadium, Hyderabad',
    'Punjab Cricket Association Stadium, Mohali'

]

# =========================================================
# TEAM LOGOS
# =========================================================

logos = {

    'Mumbai Indians': 'https://1000logos.net/wp-content/uploads/2024/03/Mumbai-Indians-Logo.png',

    'Chennai Super Kings': 'https://1000logos.net/wp-content/uploads/2024/03/Chennai-Super-Kings-Logo.png',

